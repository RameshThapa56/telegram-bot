# ---- Telegram ----
# Get this from @BotFather after "/newbot"
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Comma-separated Telegram numeric user IDs allowed to use the bot (yourself + staff).
# Get your own ID by messaging @userinfobot on Telegram.
# This is the bot's only "login" — anyone not on this list is ignored.
ADMIN_CHAT_IDS=111111111,222222222

# ---- Google Sheets ----
# The long ID in your Sheet's URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=your-google-sheet-id

# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (type "Desktop app"). See README §3.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret

# Produced once by running `node scripts/authorizeGoogle.js` — do not type this by hand.
GOOGLE_OAUTH_REFRESH_TOKEN=

# ---- Webhook deployment (Vercel/Cloud Functions) ----
# A random hard-to-guess path segment, e.g. generate with: openssl rand -hex 20
WEBHOOK_SECRET_PATH=change-me-to-a-random-string

# Your deployed base URL, no trailing slash, e.g. https://solemate-kick-bot.vercel.app
PUBLIC_URL=https://your-deployment-url.vercel.app

# ---- Business defaults (used in message templates / keyboards) ----
COUNTRY_CALLING_CODE=975
BUSINESS_NAME=SoleMate Kick

# ---- Post-delivery feedback form (optional — "Mark Delivered" feature) ----
# Both values below are written here AUTOMATICALLY by:
#   npm run setup-feedback-form
# which creates the Google Form (Order ID / Rating / Comments) for you — see
# scripts/setupFeedbackForm.js. You normally never type these by hand; they're
# shown here just so you know what they look like / can restore them.
FEEDBACK_FORM_BASE_URL=https://docs.google.com/forms/d/e/your-form-id/viewform
FEEDBACK_FORM_ORDER_ID_ENTRY=entry.123456789
